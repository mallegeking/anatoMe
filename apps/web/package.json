{
  "name": "@anatome/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync-models": "node scripts/sync-models.mjs",
    "predev": "node scripts/sync-models.mjs && npm run build-data --prefix ../..",
    "dev": "vite",
    "prebuild": "node scripts/sync-models.mjs && npm run build-data --prefix ../..",
    "build:review": "node scripts/sync-models.mjs && npm run build-data:review --prefix ../.. && tsc -b && vite build --mode review --outDir dist-review",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "camera-controls": "^3.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
