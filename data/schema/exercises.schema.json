{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Exercises",
  "description": "Exercises as phases of joint angle paths and the movements the muscles produce or resist. Cross references and the physio-only rule are checked in pipeline/data/src/validate.ts.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "english", "regions", "phases", "citations", "checked_by"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "english": { "type": "string", "minLength": 1 },
      "german": { "description": "The German name, from a source opened when it was written. The app shows the English name where it is missing.", "type": "string", "minLength": 1 },
      "regions": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 }
      },
      "phases": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "english", "path", "effort"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
            "english": { "type": "string", "minLength": 1 },
            "german": { "description": "The German name, from a source opened when it was written. The app shows the English name where it is missing.", "type": "string", "minLength": 1 },
            "path": {
              "description": "How the joints move through the phase. Angles are in degrees.",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["angle", "from", "to"],
                "properties": {
                  "angle": { "type": "string", "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$" },
                  "from": { "type": "number" },
                  "to": { "type": "number" }
                }
              }
            },
            "effort": {
              "description": "Movement ids the muscles produce or resist in this phase.",
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "citations": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref", "locator", "says", "says_kind"],
          "properties": {
            "ref": { "type": "string", "minLength": 1 },
            "locator": { "type": "string", "minLength": 1 },
            "says": { "type": "string", "minLength": 1 },
            "says_kind": { "enum": ["quote", "summary"] }
          }
        }
      },
      "checked_by": {
        "description": "Null until a physiotherapist has checked the row. Then a role label such as physio-1, never a name. Only a physio may check exercise rows, see validate.ts.",
        "type": ["string", "null"],
        "pattern": "^(owner|physio-[0-9]+)$"
      },
      "checked_on": {
        "description": "The date the row was checked, like 2026-11-03. Required when checked_by is set, see validate.ts.",
        "type": "string",
        "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
      },
      "review_note": {
        "description": "A question for the reviewer. Only the review build shows it.",
        "type": "string",
        "minLength": 1
      }
    }
  }
}
