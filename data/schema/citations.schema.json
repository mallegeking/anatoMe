{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Citations",
  "description": "Sources that action rows point to. Only sources someone can open and read.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "title", "authors", "year", "url", "license", "access"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "title": { "type": "string", "minLength": 1 },
      "authors": { "type": "string", "minLength": 1 },
      "year": { "type": "integer", "minimum": 1800, "maximum": 2100 },
      "url": { "type": "string", "pattern": "^https://" },
      "license": { "type": "string", "minLength": 1 },
      "access": { "enum": ["open"] }
    }
  }
}
