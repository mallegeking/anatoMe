{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Joints",
  "description": "Each joint lists its degrees of freedom. An angle is written joint.dof, for example hip.flexion, in degrees, positive in the direction named by positive.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "dofs"],
    "properties": {
      "id": { "$ref": "#/definitions/slug" },
      "dofs": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "positive", "negative"],
          "properties": {
            "id": { "$ref": "#/definitions/slug" },
            "positive": { "type": "string", "minLength": 1 },
            "negative": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "definitions": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
  }
}
